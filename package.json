{
  "name": "prosody",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun ./index.html",
    "build": "bun scripts/require-bun.ts && bun run typecheck && bun scripts/build.ts",
    "preview": "bun scripts/preview.ts",
    "check": "biome check .",
    "typecheck": "bun --check",
    "format": "biome check --fix .",
    "test": "bun test",
    "validate": "bun scripts/validate.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.64.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-plugin-tailwind": "0.1.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  }
}
